# ─────────────────────────────────────────────────────────────
# Remindo — root environment example
# Copy to .env for docker-compose. App-specific envs live in
# backend/.env and frontend/.env.local (see their .env.example files).
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Postgres (used by docker-compose)
POSTGRES_DB=remindo
POSTGRES_USER=remindo
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend API (Laravel)
BACKEND_PORT=8000
APP_URL=http://localhost:8000

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public domains (production)
# remindo.me           -> marketing site
# app.remindo.me       -> web app
# api.remindo.me       -> API
