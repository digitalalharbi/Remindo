# Public base URL of the Remindo API (server + client).
# Preview example: https://api-preview.remindo.me/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public site URL (used for canonical/sitemap/OpenGraph). Production: https://remindo.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Preview environment ────────────────────────────────
# Set to "true" on the public preview to show the "Preview Mode" badge and the
# "Try demo account" button on the login screen. Leave unset in production.
NEXT_PUBLIC_PREVIEW_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@remindo.me
NEXT_PUBLIC_DEMO_PASSWORD=DemoPass123!
