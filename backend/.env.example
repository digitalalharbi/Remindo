APP_NAME=Remindo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=remindo
DB_USERNAME=remindo
DB_PASSWORD=remindo

# ── Session / auth (Sanctum SPA, cookie-based) ─────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,app.remindo.me

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@remindo.me"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (documents) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ═══════════════════════════════════════════════════════
# External integrations — sandbox/mock by default.
# Supply real credentials to enable production behavior.
# ═══════════════════════════════════════════════════════

# AI extraction provider: mock | openai | anthropic
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
AI_MAX_RETRIES=2
AI_MONTHLY_TOKEN_LIMIT=200000

# Payments: sandbox | moyasar | tap | stripe
PAYMENTS_PROVIDER=sandbox
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
TAP_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS: mock | twilio | unifonic
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=Remindo

# WhatsApp: mock | meta | twilio
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# OAuth (social login) — buttons stay hidden until id + secret are set AND the
# matching feature flag (oauth_google / oauth_microsoft) is enabled in Admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Web Push (VAPID) — generate a keypair to enable
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@remindo.me
